<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginHorizontal="4dp" android:layout_marginVertical="6dp" android:padding="8dp" android:background="@drawable/item_card_bg"
    android:elevation="4dp"
    android:translationZ="2dp"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/imgItem_2150"
        android:layout_width="60dp" android:layout_height="60dp"
        android:layout_marginEnd="6dp" android:scaleType="centerCrop"
        android:background="@drawable/item_img_bg"
        android:padding="2dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvName_2150"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên sản phẩm"
            android:textSize="14sp" android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:maxLines="1" android:ellipsize="end"
            android:letterSpacing="0.02"/>

        <TextView
            android:id="@+id/tvPrice_2150"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giá: 0đ"
            android:textSize="12sp" android:textStyle="bold"
            android:textColor="#00BFA5"
            android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>