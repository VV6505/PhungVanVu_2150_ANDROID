<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layO_infoH"
        android:layout_width="411dp"
        android:layout_height="388dp"
        android:background="@drawable/bg_layoutimage"

        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/btn_back"
            android:cursorVisible="true"
            android:drawableTop="@drawable/ic_back"
            android:drawablePadding="12dp"
            app:backgroundTint="@null" />

        <ImageView
            android:id="@+id/imgUser150"
            android:layout_width="364dp"
            android:layout_height="124dp"
            android:layout_marginTop="30dp"
            android:contentDescription="TODO"
            app:srcCompat="@drawable/ic_user" />

    </LinearLayout>

    <!-- From Info Layout -->

    <LinearLayout
        android:id="@+id/layoutForm150"
        android:layout_width="364dp"
        android:layout_height="529dp"
        android:layout_margin="24dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="50dp"
        android:background="@drawable/bg_linear"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.056"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.703">

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/tvTitle150"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="45dp"
            android:gravity="center"
            android:text="CREATE YOUR ACCOUNT!"
            android:textAlignment="center"
            android:textColor="#5B5B5B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvName150"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableLeft="@drawable/ic_idcard"
            android:drawablePadding="12dp"
            android:text="FULL NAME"
            android:textColor="#3a49be"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Name -->
        <EditText
            android:id="@+id/edtName150"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:drawablePadding="12dp"
            android:hint="Type Your Name"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="#000" />

        <!-- Email -->
        <TextView
            android:id="@+id/tvEmail150"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableLeft="@drawable/ic_mail"
            android:drawablePadding="12dp"
            android:text="EMAIL"
            android:textColor="#3a49be"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Email -->
        <EditText
            android:id="@+id/edtDTEmail150"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:drawablePadding="12dp"
            android:hint="example@example.com"
            android:inputType="textEmailAddress"
            android:padding="10dp"
            android:textColor="#000" />

        <!-- Password -->
        <TextView
            android:id="@+id/tvPass150"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:drawableLeft="@drawable/ic_key"
            android:drawablePadding="12dp"
            android:text="PASSWORD"
            android:textColor="#3a49be"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Password -->
        <EditText
            android:id="@+id/edTxtPass_150"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:drawablePadding="12dp"
            android:hint="**********************"
            android:inputType="textPassword"
            android:padding="10dp"
            android:textColor="#000" />

        <!-- Password -->
        <TextView
            android:id="@+id/tvre_Pass150"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:drawableLeft="@drawable/ic_key"
            android:drawablePadding="12dp"
            android:text="RE-TYPE PASSWORD"
            android:textColor="#3a49be"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Re-typePassword -->
        <EditText
            android:id="@+id/re_typepass150"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:drawablePadding="12dp"
            android:hint="**********************"
            android:inputType="textPassword"
            android:padding="10dp"
            android:textColor="#000" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCreate150"
        android:layout_width="215dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#007BFF"
        android:text="CREATE"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.892" />

    <TextView
        android:id="@+id/tvLLogin150"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:cursorVisible="true"
        android:text="ADREADY HAVE AN ACCOUNT?"
        android:textColor="#0CED0C"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCreate150"
        app:layout_constraintVertical_bias="0.918" />

</androidx.constraintlayout.widget.ConstraintLayout>